# Podman release to build: https://github.com/containers/podman/releases
PODMAN_VERSION=6.1.4
# conmon and crun versions of podman-static PODMAN_VERSION (see its Dockerfile).
CONMON_VERSION=2.2.1
CRUN_VERSION=1.30.1
# Go release that builds Podman. It must satisfy the go line in Podman's go.mod.
GO_VERSION=1.26.10
# SHA-256 of the podman-static archives of PODMAN_VERSION (https://github.com/mgoltzsche/podman-static/releases).
# Verify the GPG signature of each archive before you change them:
#   gpg --keyserver hkps://keyserver.ubuntu.com --recv-keys 0CCF102C4F95D89E583FF1D4F8B5AF50344BB503
#   gpg --verify podman-linux-amd64.tar.gz.asc podman-linux-amd64.tar.gz
PODMAN_STATIC_SHA256_amd64=9dd51073fac5a1742f88cf3caff5554615cb4d67ba554d25e8807be635547af5
PODMAN_STATIC_SHA256_arm64=c106d09d7524209ce01eb3a02a7e621e9c55ec31d0fada48439cf77aa07afdb6
